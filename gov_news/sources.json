{
  "_readme": [
    "源清单：增删本条目的 sources 数组即可，不需要改代码。",
    "字段说明：",
    "  key            机器名（产物里的 source 字段）",
    "  name           显示名",
    "  url            列表页地址",
    "  enabled        是否启用（false = 暂时关掉但不删）",
    "  engine         static=HTTP直取（快） / browser=隐身浏览器（慢但能过 JS/反爬）",
    "  verify         SSL 证书是否校验。mod.gov.cn、81.mil.cn 的证书与域名不匹配，必须 false",
    "  list_selector  在列表页里定位文章链接的 CSS 选择器（可写多个，逗号分隔）",
    "  link_re        对绝对 URL 的正则过滤，只保留文章页（避免抓到栏目页/首页）",
    "  title_selector 详情页标题选择器；留空则按 h1 -> <title> 依次兜底",
    "  body_selector  详情页正文容器；留空则用启发式自动找（不保证准，建议显式配置）",
    "  limit          每个源最多抓几篇（默认值，可被命令行 --limit 覆盖）",
    "  note           本源的坑，写在这里免得下次重踩"
  ],
  "sources": [
    {
      "key": "mod",
      "name": "国防部网",
      "url": "https://www.mod.gov.cn/",
      "enabled": true,
      "engine": "static",
      "verify": false,
      "list_selector": "ul.news-list li a, div.tab-bd ul.top-news-list li a",
      "link_re": "mod\\.gov\\.cn/.+\\d{6,}\\.html$",
      "title_selector": "h1",
      "body_selector": ".article-content",
      "limit": 5,
      "note": "证书 CN 与域名不匹配（curl 60），必须 verify=false；正文在 .article-content"
    },
    {
      "key": "mod_qwfb",
      "name": "国防部·记者会专题",
      "url": "https://www.mod.gov.cn/gfbw/qwfb/",
      "enabled": true,
      "engine": "static",
      "verify": false,
      "list_selector": "ul.news-list li a, ul.rich-news-list li a",
      "link_re": "mod\\.gov\\.cn/gfbw/.+\\d{6,}\\.html$",
      "title_selector": "h1",
      "body_selector": ".article-content",
      "limit": 5,
      "note": "同上；记者会/权威发布都在 /gfbw/ 下"
    },
    {
      "key": "mil81",
      "name": "中国军网",
      "url": "https://www.81.mil.cn/",
      "enabled": true,
      "engine": "static",
      "verify": false,
      "list_selector": "ul.news-list li a",
      "link_re": "81\\.mil\\.cn/.+\\d{6,}\\.html$",
      "title_selector": "h1",
      "body_selector": "#article-content",
      "limit": 5,
      "note": "证书同样不匹配，verify=false；正文容器是 #article-content"
    },
    {
      "key": "fmprc",
      "name": "外交部",
      "url": "https://www.fmprc.gov.cn/",
      "enabled": true,
      "engine": "static",
      "verify": true,
      "list_selector": "a",
      "link_re": "fmprc\\.gov\\.cn/.+/t20\\d{6}_\\d+\\.shtml$",
      "title_selector": "div.news-title, h1",
      "body_selector": "div#News_Body_Txt_A, div.TRS_UEDITOR",
      "limit": 5,
      "note": "文章 URL 有固定形态 t<日期>_<id>.shtml，直接用 link_re 过滤最稳；正文在 #News_Body_Txt_A"
    },
    {
      "key": "ccg",
      "name": "中国海警局",
      "url": "https://www.ccg.gov.cn/",
      "enabled": true,
      "engine": "static",
      "verify": true,
      "list_selector": "ul.text-news li a",
      "link_re": "ccg\\.gov\\.cn/(wqzf|hjyw|lbt|xxgk|swqx)/.+\\d{4}\\.html$",
      "title_selector": "div.section-cnt-tit, h1",
      "body_selector": "div.trs_editor_view, div.article-main",
      "limit": 5,
      "note": "首页列表是 ul.text-news > li.text-news-item；正文在 .trs_editor_view（TRS 编辑器）"
    },
    {
      "key": "ccg_wqzf",
      "name": "海警局·维权执法",
      "url": "https://www.ccg.gov.cn/wqzf/",
      "enabled": true,
      "engine": "static",
      "verify": true,
      "list_selector": "div.tit-wrap p.title a, ul.djph1 li a, ul.djph2 li a",
      "link_re": "ccg\\.gov\\.cn/wqzf/.+\\d{4}\\.html$",
      "title_selector": "div.section-cnt-tit, h1",
      "body_selector": "div.trs_editor_view, div.article-main",
      "limit": 5,
      "note": "专栏用 /wqzf/（带 index.html 的地址会超时，用目录形式）；有分页 index_1.html…index_23.html"
    },
    {
      "key": "scspi",
      "name": "南海战略态势感知(SCSPI)",
      "url": "https://www.scspi.org/",
      "enabled": true,
      "engine": "browser",
      "verify": true,
      "list_selector": "a",
      "link_re": "scspi\\.org/zh/(yjbg|dtfx|zdhd|militaryposture|maritimepolicies|marinedevelopment|rulesandorder)/\\d+",
      "title_selector": "h1",
      "body_selector": "div.field--name-body, div.node__content, article",
      "limit": 3,
      "note": "静态请求 SSL/连接异常，必须用浏览器；文章 URL 无扩展名（/zh/分类/时间戳），靠 link_re 过滤"
    },
    {
      "key": "nanhai",
      "name": "中国南海研究院",
      "url": "https://www.nanhai.org.cn/index.html",
      "enabled": true,
      "engine": "static",
      "verify": true,
      "list_selector": "div#imgLIst a, div.contList h3 a, div.contList li a",
      "link_re": "nanhai\\.org\\.cn/info-detail/\\d+/\\d+\\.html$",
      "title_selector": "h1",
      "body_selector": "div.textHer",
      "limit": 5,
      "note": "正文在 div.textHer（外层 #div_content 会带标题和来源行）"
    },
    {
      "key": "xinhua",
      "name": "新华网",
      "url": "https://www.news.cn/",
      "enabled": true,
      "engine": "static",
      "verify": true,
      "list_selector": "div.list.list-txt ul li a",
      "link_re": "news\\.cn/.+/c\\.html$",
      "title_selector": "h1, title",
      "body_selector": "span#detailContent, div#detail",
      "limit": 5,
      "note": "文章 URL 以 /c.html 结尾；h1 常为空，用 #detail 兜底；正文在 span#detailContent"
    },
    {
      "key": "people",
      "name": "人民网",
      "url": "https://www.people.com.cn/",
      "enabled": true,
      "engine": "static",
      "verify": true,
      "list_selector": "ul.list6.cf li a, ul.cf.blist1 li a, div.fr ul li a",
      "link_re": "people\\.com\\.cn/n\\d/\\d{4}/\\d{4}/c\\d+-\\d+\\.html$",
      "title_selector": "h1",
      "body_selector": "div#rm_txt_zw, div.rm_txt_con",
      "limit": 5,
      "note": "首页聚合了多个 ul 列表；正文在 #rm_txt_zw"
    },
    {
      "key": "cctv",
      "name": "央视网",
      "url": "https://tv.cctv.com/",
      "enabled": true,
      "engine": "static",
      "verify": true,
      "list_selector": "div.text.hover a, div.text div.title a, li div.title a",
      "link_re": "tv\\.cctv\\.com/\\d{4}/\\d{2}/\\d{2}/VIDE.+\\.shtml$",
      "title_selector": "div.tit, h1, title",
      "body_selector": "div.video_brief",
      "limit": 5,
      "note": "视频页没有长正文，正文等于 div.video_brief 里的节目简介（已注明）"
    },
    {
      "key": "xinhua_mil",
      "name": "新华网·军事",
      "url": "https://www.news.cn/milpro/index.htm",
      "enabled": true,
      "engine": "static",
      "verify": true,
      "list_selector": "p.name a, div.tit a, li a",
      "link_re": "news\\.cn/milpro/.+/c\\.html$",
      "title_selector": "h1, title",
      "body_selector": "span#detailContent, div#detail",
      "limit": 5,
      "note": "比新华网首页命中率高得多（首页排的是时政要闻）"
    },
    {
      "key": "people_mil",
      "name": "人民网·军事",
      "url": "http://military.people.com.cn/",
      "enabled": true,
      "engine": "static",
      "verify": true,
      "list_selector": "h5 a, em a, li a",
      "link_re": "military\\.people\\.com\\.cn/n\\d/\\d{4}/\\d{4}/c\\d+-\\d+\\.html$",
      "title_selector": "h1",
      "body_selector": "div#rm_txt_zw, div.rm_txt_con",
      "limit": 5,
      "note": "军事频道，正文容器与人民网主站一致"
    },
    {
      "key": "xinhua_world",
      "name": "新华网·国际",
      "url": "https://www.news.cn/world/index.html",
      "enabled": true,
      "engine": "static",
      "verify": true,
      "list_selector": "div.tit a, h3 a, li a",
      "link_re": "news\\.cn/world/.+/c\\.html$",
      "title_selector": "h1, title",
      "body_selector": "span#detailContent, div#detail",
      "limit": 5,
      "note": "国际新闻频道，涉海/周边报道多"
    },
    {
      "key": "mod_search_scs",
      "name": "国防部网·站内检索(南海)",
      "url": "http://www.mod.gov.cn/",
      "enabled": true,
      "engine": "api",
      "verify": false,
      "detail_engine": "static",
      "detail_verify": false,
      "skip_keyword_filter": true,
      "api": {
        "url": "http://mod-search.mod.gov.cn/api-surface/es/docSearchEasy",
        "verify": false,
        "timeout": 25,
        "params": {
          "pageNumber": "{page}",
          "pageSize": 10,
          "returnFields": "",
          "indexNames": "manuscript",
          "highlightType": 2,
          "title": "{keyword}",
          "searchType": 2,
          "channelId": 718
        },
        "search_keywords": [
          "南海"
        ],
        "pages": 10,
        "items_path": "data.resultList",
        "total_path": "data.total",
        "title_field": "title",
        "url_field": "manuscriptData.url",
        "date_field": "issueTime",
        "desc_field": "desc",
        "category_field": "manuscriptData.classify_name"
      },
      "title_selector": "h1",
      "body_selector": ".article-content",
      "limit": 20,
      "note": "engine=api：直接调它自己的站内检索接口 mod-search.mod.gov.cn/api-surface/es/docSearchEasy（从 index.js 里扒出来的）。title 参数=按标题检索，searchType 2=模糊匹配，channelId 718=国防部网主站。skip_keyword_filter=true 因为服务端已经按关键词筛过。改关键词就改 search_keywords（可用多个，逐个查再合并）；pages 是每个关键词翻几页（每页 10 条）；min_body_length=60 用来丢掉「记者会索引页/图片快讯」这类空壳（正文其实在子链接里）",
      "min_body_length": 60
    }
  ]
}
